        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面暗黑的部分。按住 Option 可查看溢出的暗部。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
