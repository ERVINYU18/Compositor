    "Highlight Recovery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光恢复"
          }
        }
      }
    },
    "Smooths grain, at the cost of fine detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑噪点，代价是损失一部分细节"
          }
        }
      }
    },
    "Removes the lens's distortion and vignetting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消除镜头的畸变与暗角"
          }
        }
      }
    },
    "This file has no lens profile": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件没有镜头配置文件"
          }
        }
      }
    },
    "Brings back detail in bright areas the camera partly clipped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找回相机部分过曝区域里的细节"
          }
        }
      }
