        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定最亮点。按住 Option 可查看溢出的高光。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定最暗点。按住 Option 可查看溢出的暗部。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把画面由蓝色调向黄色。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把画面由绿色调向紫红色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对不鲜艳的颜色比已经鲜艳的颜色增强更多，并保护肤色。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同幅度整体增强或减弱所有颜色。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化细节纹理。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化较大形状的对比度。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高时去雾，降低时加雾。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让明亮区域散发辉光。"
          }
        }
      }
    },
    "Chooses how bright an area must be to glow. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定区域要多亮才会发光。提高「辉光」前不起作用。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定辉光的扩散范围。提高「辉光」前不起作用。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让辉光由冷向暖偏移；光晕始终偏红。提高「辉光」前不起作用。"
          }
        }
      }
    },
    "Darkens or lightens the edges. The center does not change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮边缘。中心不变。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定暗角从中心向外的起始位置。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让暗角更圆或更方。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化暗角的边缘。"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "施加暗角时保护明亮像素。「高光优先」会用到。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调最明显。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更粗或更细。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颗粒更平滑或更斑驳。"
          }
        }
      }
    },
    "Reset %@ to its defaults": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将%@重置为默认值"
          }
        }
      }
    },
    "Reset %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置%@"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动可提升或压低这些色调。沿底部分隔条拖动可改变每个区域覆盖的色调。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点；单击可添加控制点，双击控制点可将其移除。"
          }
        }
      }
    },
    "Lifts or lowers the brightest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升或压低最亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the light tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升或压低较亮的色调。"
          }
        }
      }
    },
    "Lifts or lowers the dark tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升或压低较暗的色调。"
          }
        }
      }
    },
    "Lifts or lowers the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升或压低最暗的色调。"
          }
        }
      }
    },
    "In %lld   Out %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %lld   输出 %lld"
          }
        }
      }
    },
    "How much the curve also changes color strength. Zero matches Photoshop; lower keeps it to brightness, higher adds more color.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线同时改变颜色强度的程度。0 与 Photoshop 一致；更低只改变亮度，更高会加入更多颜色。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面上拖动，可移动指针所指色调的曲线。"
          }
        }
      }
    },
    "Shifts the selected color family around the wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所选色系沿色轮偏移。"
          }
        }
      }
    },
    "Makes the selected color family stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所选色系更浓或更淡。"
          }
        }
      }
    },
    "Makes the selected color family lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所选色系更亮或更暗。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所拾取的颜色沿色轮偏移。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所拾取的颜色更浓或更淡。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让所拾取的颜色更亮或更暗。"
          }
        }
      }
    },
    "How far in hue the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在色相方向的作用范围。"
          }
        }
      }
    },
    "How far in saturation the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在饱和度方向的作用范围。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整在明度方向的作用范围。"
          }
        }
      }
    },
    "Controls how much the three tonal wheels overlap.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制三个色调色轮之间的重叠程度。"
          }
        }
      }
    },
    "Shifts the wheels toward shadows or highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让色轮偏向暗部或高光。"
          }
        }
      }
    },
    "Brightness added by this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此色轮加入的亮度。"
          }
        }
      }
    },
    "Controls how strong the sharpening is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化的强度。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从每条边缘延伸的距离（像素）。"
          }
        }
      }
    },
    "Emphasizes fine texture over broader edges.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强调细微纹理，而非较大的边缘。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只锐化较强的边缘。按住 Option 可查看蒙版。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑亮度的颗粒与噪点。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少亮度噪点的同时保留细微纹理。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度平滑后保留局部对比度。"
          }
        }
      }
    },
    "Smooths colored speckles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑彩色斑点。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在减少颜色噪点的同时保留彩色边缘。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让颜色平滑更柔和或更紧凑。"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件畸变校正的应用程度。"
          }
        }
      }
    },
    "How much of the profile vignetting correction is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件暗角校正的应用程度。"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正桶形或枕形弯曲。"
          }
        }
      }
    },
    "Weakens purple fringes inside the purple hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱紫色色相范围内的紫边。"
          }
        }
      }
    },
    "Hue range where purple defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色去边生效的色相范围。"
          }
        }
      }
    },
    "Weakens green fringes inside the green hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱绿色色相范围内的绿边。"
          }
        }
      }
    },
    "Hue range where green defringe runs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绿色去边生效的色相范围。"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗四角，抵消镜头暗角。"
          }
        }
      }
    },
    "Moves the vignette correction inward or outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让暗角校正向内或向外移动。"
          }
        }
      }
    },
    "Purple": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫色"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把垂直线校正向中心。"
          }
        }
      }
    },
    "Straightens horizontal lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把水平线校正向中心。"
          }
        }
      }
    },
    "Rotates the picture around its center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕中心旋转画面。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对高度拉伸宽度。"
          }
        }
      }
    },
    "Zooms the transformed picture within the frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画框内缩放变换后的画面。"
          }
        }
      }
    },
    "Moves the picture left or right.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移动画面。"
          }
        }
      }
    },
    "Moves the picture up or down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下移动画面。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调加入绿色或洋红色。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整红色的解释方式。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱红色原色。"
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整绿色的解释方式。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱绿色原色。"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整蓝色的解释方式。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        }
      }
    },
    "Shift-click adds a color, Option-click takes one away.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 点按可添加颜色，按住 Option 点按可减去颜色。"
          }
        }
      }
    },
    "Click the image to pick the color to select.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图像以拾取要选择的颜色。"
          }
        }
      }
    },
    "Click the image to select that color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图像以选择该颜色"
          }
        }
      }
    },
    "Click the image to add that color to the selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图像以将该颜色加入选区"
          }
        }
      }
    },
    "Click the image to take that color out of the selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图像以将该颜色从选区中移出"
          }
        }
      }
    },
    "HDR layer: keeps light brighter than white, shown as white": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR 图层：保留比白色更亮的亮度，显示为白色"
          }
        }
      }
    },
    "16-bit layer: keeps 16 bits a channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "16 位图层：每通道保留 16 位"
          }
        }
      }
    },
    "HDR": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR"
          }
        }
      }
    },
    "16-Bit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
